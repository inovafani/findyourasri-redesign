# The Bunny pull zone that serves the long films (lib/content.ts, media()).
# Unset, the films load from /public/video as in local development.
NEXT_PUBLIC_MEDIA_URL=https://asri-media.b-cdn.net

# Google Analytics 4 measurement ID, tagged directly (app/layout.tsx). Unset,
# GA4 does not load. Set it on Vercel (Production), not in .env.local, so local
# development sends nothing to the live property.
NEXT_PUBLIC_GA_ID=G-30QSGWN1JL

# Google Tag Manager container (W11). Unset, no tags load.
NEXT_PUBLIC_GTM_ID=

# Client profile intake (/client-profile/): the Supabase Edge Function the form
# talks to, https://<project-ref>.supabase.co/functions/v1/client-profile.
# Unset, the form still fills in but cannot send.
NEXT_PUBLIC_CLIENT_PROFILE_API=

# Cloudflare Turnstile site key for the same form. Optional: unset, no check is
# shown (set TURNSTILE_SECRET_KEY on the function to match when you turn it on).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
